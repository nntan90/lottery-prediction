# Environment Variables Template
# Copy file này thành .env và điền thông tin thực

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Telegram Bot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# XSMN LLM_Gen shadow (off | shadow; exactly one provider per run)
LLM_GEN_MODE=off
LLM_GEN_PROVIDER=openai
# OpenAI logical provider backend (official | agentrouter; never a custom URL).
# official keeps its current Responses model; agentrouter uses GPT-5.6 through
# the fixed https://agentrouter.org/v1 Responses contract.
LLM_GEN_OPENAI_BACKEND=official
OPENAI_API_KEY=
AGENTROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional: Logging level
LOG_LEVEL=INFO
